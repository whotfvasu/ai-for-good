# Copy to .env.local. NEXT_PUBLIC_ prefix exposes the var to the browser.
# All three of these are read at *build* time for Amplify, so changing them
# requires a redeploy on Amplify (or a dev-server restart locally).

# Live API base URL. Either the API Gateway URL (deployed) or
# http://localhost:8000 (running scripts/local_api.py).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to mock *all* routes. Useful when no backend is running at all.
# Leave unset or "false" once you have NEXT_PUBLIC_API_URL pointing somewhere live.
NEXT_PUBLIC_USE_MOCKS=false

# Set to "true" to use live API for L1 (forecast, rank-donors, family/ack, health)
# but keep L2 routes (saathi/*, refusals, diary, pulse) mocked. This is
# checkpoint mode — works the moment the L1 backend ships, no waiting on L2.
NEXT_PUBLIC_USE_L2_MOCKS=true

# Demo anchor date — the dataset is 2025-dated, so we pin forecasts to a
# known window. Coordinator + family pages forward this to /forecast and
# /rank-donors automatically.
NEXT_PUBLIC_DEMO_ANCHOR_DATE=2025-08-17
